generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  adminId  Int    @id @default(autoincrement()) @map("id_admin")
  name     String @map("nombre")
  lastName String @map("apellidos")
  email    String @unique @map("email")
  password String @map("password")

  @@map("admin")
}

model Category {
  categoryId Int    @id @default(autoincrement()) @map("id_categoria")
  name       String @map("nombre")

  productTypes      ProductType[]
  productCategories ProductCategory[]

  @@map("categoria")
}

model Customer {
  customerId   Int      @id @default(autoincrement()) @map("id_cliente")
  firstName    String   @map("nombre")
  lastName     String?  @map("apellidos")
  email        String   @unique @map("email")
  password     String   @map("password")
  points       Decimal? @default(0) @map("puntos")
  documentType String?  @map("tipo_documento")
  dni          String?  @map("dni")
  ruc          String?  @map("ruc")
  businessName String?  @map("razon_social")
  address      String?  @map("direccion")
  taxAddress   String?  @map("direccion_fiscal")

  paymentMethods PaymentMethod[]
  orders         Order[]

  @@map("cliente")
}

model Receipt {
  receiptId    Int      @id @default(autoincrement()) @map("id_comprobante")
  orderId      Int      @map("id_pedido")
  type         String?  @map("tipo")
  series       String?  @map("serie")
  correlative  Int?     @map("correlativo")
  date         DateTime? @default(now()) @map("fecha")
  dni          String?  @map("dni")
  ruc          String?  @map("ruc")
  businessName String?  @map("razon_social")
  address      String?  @map("direccion")
  taxAddress   String?  @map("direccion_fiscal")
  order        Order    @relation(fields: [orderId], references: [orderId])

  @@map("comprobante")
}

model OrderDetail {
  orderDetailId Int      @id @default(autoincrement()) @map("id_detalle_pedido")
  orderId       Int      @map("id_pedido")
  productId     Int?     @map("id_producto")
  menuId        Int?     @map("id_menu")
  quantity      Int?     @map("cantidad")
  price         Decimal? @map("precio")
  subtotal      Decimal? @map("subtotal")
  tax           Decimal? @map("igv")
  order         Order    @relation(fields: [orderId], references: [orderId])
  product       Product? @relation(fields: [productId], references: [productId])
  menu          Menu?    @relation(fields: [menuId], references: [menuId])

  @@map("detalle_pedido")
}

model Menu {
  menuId      Int     @id @default(autoincrement()) @map("id_menu")
  name        String  @map("nombre")
  description String? @map("descripcion")
  image       String? @map("imagen")
  price       Decimal? @map("precio")
  category    String? @map("tipo_menu")

  orderDetails OrderDetail[]
  menuProducts MenuProduct[]

  @@map("menu")
}

model MenuProduct {
  menuId    Int @map("id_menu")
  productId Int @map("id_producto")
  quantity  Int? @map("cantidad")

  menu    Menu    @relation(fields: [menuId], references: [menuId])
  product Product @relation(fields: [productId], references: [productId])

  @@id([menuId, productId])
  @@map("menu_producto")
}

model PaymentMethod {
  paymentMethodId Int     @id @default(autoincrement()) @map("id_metodo_pago")
  customerId      Int     @map("id_cliente")
  name            String  @map("nombre")
  number          String? @map("numero")

  customer Customer @relation(fields: [customerId], references: [customerId])
  orders   Order[]

  @@map("metodo_pago")
}

model Order {
  orderId          Int      @id @default(autoincrement()) @map("id_pedido")
  customerId       Int      @map("id_cliente")
  paymentMethodId  Int      @map("id_metodo_pago")
  date             DateTime? @default(now()) @map("fecha")
  subtotal         Decimal? @map("subtotal")
  tax              Decimal? @map("igv")
  discount         Decimal? @default(0) @map("descuento")
  total            Decimal? @map("total")
  deliveryAddress  String?  @map("direccion_entrega")
  shippingMethod   String?  @map("metodo_envio")
  notes            String?  @map("notas")
  pointsUsed       Decimal? @default(0) @map("puntos_usados")

  customer      Customer      @relation(fields: [customerId], references: [customerId])
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [paymentMethodId])
  orderDetails  OrderDetail[]
  receipts      Receipt[]

  @@map("pedido")
}

model Product {
  productId     Int     @id @default(autoincrement()) @map("id_producto")
  name          String  @map("nombre")
  description   String? @map("descripcion")
  price         Decimal @map("precio")
  image         String? @map("imagen")
  stock         Int?    @map("stock")
  productTypeId Int     @map("id_tipo_producto")

  productType      ProductType      @relation(fields: [productTypeId], references: [productTypeId])
  orderDetails     OrderDetail[]
  menuProducts     MenuProduct[]
  productCategories ProductCategory[]

  @@map("producto")
}

model ProductCategory {
  productId  Int @map("id_producto")
  categoryId Int @map("id_categoria")

  product  Product  @relation(fields: [productId], references: [productId])
  category Category @relation(fields: [categoryId], references: [categoryId])

  @@id([productId, categoryId])
  @@map("producto_categoria")
}

model ProductType {
  productTypeId Int     @id @default(autoincrement()) @map("id_tipo_producto")
  name          String  @map("nombre")
  image         String? @map("imagen")
  categoryId    Int     @map("id_categoria")

  category Category  @relation(fields: [categoryId], references: [categoryId])
  products Product[]

  @@map("tipo_producto")
}
